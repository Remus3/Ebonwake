#!/bin/sh
# EW pre-push: kit v13 identity gate (FLEET-COMMON 17), then the leak sweep
# over the pushed range (added lines + commit messages). Stdin carries git's
# ref lines; both checks get them unchanged.
ROOT="$(git rev-parse --show-toplevel)"
PY="${PYTHON:-py}"
command -v "$PY" >/dev/null 2>&1 || PY=python
command -v "$PY" >/dev/null 2>&1 || { echo "[leak-sweep] FAULT - no python" >&2; exit 3; }
REFS="$(cat)"
printf '%s\n' "$REFS" | python "$ROOT/ops/fleet_kit/fleet_identity.py" pre-push "$@" || exit 1
printf '%s\n' "$REFS" | exec "$PY" "$ROOT/tools/leak_sweep.py" --pre-push "$@"
