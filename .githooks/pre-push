#!/bin/sh
# EW pre-push: leak sweep over the pushed range (added lines + commit messages).
# Stdin carries git's ref lines; it is handed to the sweep unchanged.
ROOT="$(git rev-parse --show-toplevel)"
PY="${PYTHON:-py}"
command -v "$PY" >/dev/null 2>&1 || PY=python
command -v "$PY" >/dev/null 2>&1 || { echo "[leak-sweep] FAULT - no python" >&2; exit 3; }
exec "$PY" "$ROOT/tools/leak_sweep.py" --pre-push "$@"
