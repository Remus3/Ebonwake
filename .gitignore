# Secrets and per-host config - NEVER commit (secrets live in user env vars,
# referenced through fleet_secrets from config/local.json).
config/local.json
config/leak_needles.json
.env
.env.*
*.key
*.pem
API-Key*
*.secret
*_token.txt

# Runtime state, caches, store, logs
ops/runtime/
ops/loop/control/*
!ops/loop/control/.gitkeep
# kit v9 /done marker (fleet_done.py); already covered above, named explicitly
ops/loop/control/session_done.json
ops/loop/control/session_done.seen
# kit v10 subagent-first hook mode + decision log; covered above, named explicitly
ops/loop/control/subagent_first.mode
ops/loop/control/subagent_first.jsonl
# kit v12 race guards (claims, git lock) + kit v13 identity log; covered above,
# named explicitly
ops/loop/control/claims/
ops/loop/control/locks/
ops/loop/control/claims.jsonl
ops/loop/control/claims.mode
ops/loop/control/gitlock.jsonl
ops/loop/control/identity.jsonl
logs/
*.log

# Channel (per-host, never published)
moon_sync_inbox/
moon_sync_outbox/

# Python / Node
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
app/out/
app/dist/

# Claude per-host
.claude/settings.local.json
.claude/worktrees/
_scratch/
