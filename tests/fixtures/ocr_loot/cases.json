{
  "_doc": "Plan 040 synthetic OCR bench: hand-written OCR line outputs shaped like a loot window or the chat acquisition log, with the misreads Tesseract makes on game UI fonts (l/1, O/0, rn/m, dropped or swapped brackets, x read as X (the multiplication sign is a unit test, keeping this file ASCII), comma read as a space or a dot). No game assets. Each case: names (the spot's loot list), lines (str, or {text, x, y, w, h} with geometry), expect [{name, count}] (count null when the screenshot shows none). Scored by tests/test_ocr.py: exact rows / max(expected, parsed) summed over cases.",
  "cases": [
    {"id": "c01-clean-window",
     "names": ["Black Stone (Weapon)", "Black Stone (Armor)", "Ancient Spirit Dust"],
     "lines": ["Loot", "Black Stone (Weapon) x12", "Black Stone (Armor) x7", "Ancient Spirit Dust x3"],
     "expect": [{"name": "Black Stone (Weapon)", "count": 12}, {"name": "Black Stone (Armor)", "count": 7},
                {"name": "Ancient Spirit Dust", "count": 3}]},
    {"id": "c02-commas",
     "names": ["Ancient Relic Crystal Shard", "Forest Fury", "Black Stone (Armor)"],
     "lines": ["Forest Fury x1,234", "Black Stone (Armor) x 12,045", "Ancient Relic Crystal Shard x2"],
     "expect": [{"name": "Forest Fury", "count": 1234}, {"name": "Black Stone (Armor)", "count": 12045},
                {"name": "Ancient Relic Crystal Shard", "count": 2}]},
    {"id": "c03-comma-as-space-and-dot",
     "names": ["Forest Fury", "Trace of Nature"],
     "lines": ["Forest Fury x 1 234", "Trace of Nature x2.500"],
     "expect": [{"name": "Forest Fury", "count": 1234}, {"name": "Trace of Nature", "count": 2500}]},
    {"id": "c04-misreads",
     "names": ["Black Stone (Weapon)", "Black Stone (Armor)", "Caphras Stone"],
     "lines": ["B1ack St0ne (Weap0n) x9", "Black Stone {Armor) X4", "Caphras Stane x1"],
     "expect": [{"name": "Black Stone (Weapon)", "count": 9}, {"name": "Black Stone (Armor)", "count": 4},
                {"name": "Caphras Stone", "count": 1}]},
    {"id": "c05-rn-m",
     "names": ["Memory Fragment", "Hard Black Crystal Shard", "Sharp Black Crystal Shard"],
     "lines": ["Mernory Fragment x2", "Hard Black Crystal Shard x5", "Sharp Black Crysta1 Shard x6"],
     "expect": [{"name": "Memory Fragment", "count": 2}, {"name": "Hard Black Crystal Shard", "count": 5},
                {"name": "Sharp Black Crystal Shard", "count": 6}]},
    {"id": "c06-capital-x",
     "names": ["Ancient Spirit Dust", "Black Stone (Weapon)"],
     "lines": ["Ancient Spirit Dust X14", "Black Stone (Weapon) X 3"],
     "expect": [{"name": "Ancient Spirit Dust", "count": 14}, {"name": "Black Stone (Weapon)", "count": 3}]},
    {"id": "c07-leading-counts",
     "names": ["Forest Fury", "Caphras Stone"],
     "lines": ["1,520 Forest Fury", "2x Caphras Stone"],
     "expect": [{"name": "Forest Fury", "count": 1520}, {"name": "Caphras Stone", "count": 2}]},
    {"id": "c08-chat-log-sums",
     "names": ["Black Stone (Weapon)", "Black Stone (Armor)", "Ancient Spirit Dust"],
     "lines": ["You obtained Black Stone (Weapon) x2", "You obtained Black Stone (Armor) x1",
               "You obtained Black Stone (Weapon) x3", "You obtained Ancient Spirit Dust x4"],
     "expect": [{"name": "Black Stone (Weapon)", "count": 5}, {"name": "Black Stone (Armor)", "count": 1},
                {"name": "Ancient Spirit Dust", "count": 4}]},
    {"id": "c09-unknown-and-junk",
     "names": ["Black Stone (Weapon)", "Forest Fury"],
     "lines": ["Silver 12,345,678", "Weight 1,203.5 / 2,100 LT", "Pirate Gold Coin x3",
               "Forest Fury x800", "Black Stone (Weapon) x2"],
     "expect": [{"name": "Forest Fury", "count": 800}, {"name": "Black Stone (Weapon)", "count": 2}]},
    {"id": "c10-no-count",
     "names": ["Caphras Stone", "Memory Fragment"],
     "lines": ["Caphras Stone", "Memory Fragment x1"],
     "expect": [{"name": "Caphras Stone", "count": null}, {"name": "Memory Fragment", "count": 1}]},
    {"id": "c11-grid-count-beside",
     "names": ["Forest Fury", "Black Stone (Armor)"],
     "lines": [{"text": "Forest Fury", "x": 100, "y": 200, "w": 120, "h": 18},
               {"text": "3,210", "x": 260, "y": 201, "w": 50, "h": 17},
               {"text": "Black Stone (Armor)", "x": 100, "y": 240, "w": 180, "h": 18},
               {"text": "7", "x": 300, "y": 240, "w": 10, "h": 18}],
     "expect": [{"name": "Forest Fury", "count": 3210}, {"name": "Black Stone (Armor)", "count": 7}]},
    {"id": "c12-grid-count-below",
     "names": ["Ancient Spirit Dust"],
     "lines": [{"text": "Ancient Spirit Dust", "x": 50, "y": 100, "w": 160, "h": 18},
               {"text": "x25", "x": 60, "y": 122, "w": 30, "h": 16}],
     "expect": [{"name": "Ancient Spirit Dust", "count": 25}]},
    {"id": "c13-brackets-dropped",
     "names": ["Black Stone (Weapon)", "Black Stone (Armor)"],
     "lines": ["Black Stone Weapon x10", "Black Stone Arrnor x11"],
     "expect": [{"name": "Black Stone (Weapon)", "count": 10}, {"name": "Black Stone (Armor)", "count": 11}]},
    {"id": "c14-prefix-noise",
     "names": ["Trace of Nature", "Forest Fury"],
     "lines": ["[Item] Trace of Nature x40", "* Forest Fury x1,000 acquired"],
     "expect": [{"name": "Trace of Nature", "count": 40}, {"name": "Forest Fury", "count": 1000}]},
    {"id": "c15-near-miss-rejected",
     "names": ["Forest Fury", "Caphras Stone"],
     "lines": ["Forest Feather x5", "Caphras Stone x2"],
     "expect": [{"name": "Caphras Stone", "count": 2}]},
    {"id": "c16-case-and-spacing",
     "names": ["Hard Black Crystal Shard", "Ancient Spirit Dust"],
     "lines": ["HARD BLACK CRYSTAL SHARD x2", "ancient  spirit   dust   x 9"],
     "expect": [{"name": "Hard Black Crystal Shard", "count": 2}, {"name": "Ancient Spirit Dust", "count": 9}]},
    {"id": "c17-big-count",
     "names": ["Forest Fury"],
     "lines": ["Forest Fury x123,456"],
     "expect": [{"name": "Forest Fury", "count": 123456}]},
    {"id": "c18-o-in-count",
     "names": ["Forest Fury", "Trace of Nature"],
     "lines": ["Forest Fury x1O5", "Trace of Nature xl2"],
     "expect": [{"name": "Forest Fury", "count": 105}, {"name": "Trace of Nature", "count": 12}]},
    {"id": "c19-two-similar",
     "names": ["Sharp Black Crystal Shard", "Hard Black Crystal Shard"],
     "lines": ["Shamp Black Crystal Shard x3", "Hard Biack Crystal Shard x8"],
     "expect": [{"name": "Sharp Black Crystal Shard", "count": 3}, {"name": "Hard Black Crystal Shard", "count": 8}]},
    {"id": "c20-empty",
     "names": ["Forest Fury"],
     "lines": ["", "Loot", "Close"],
     "expect": []}
  ]
}
